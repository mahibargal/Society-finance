# Local development — copy to server/.env.development (gitignored)
#   copy server\.env.development.example server\.env.development

NODE_ENV=development
APP_ENV=development

# PostgreSQL on localhost (create database `society` first):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/society?schema=public

# Or embedded DB: DATABASE_URL=postgresql://society:society@127.0.0.1:54331/society?schema=public

JWT_SECRET=dev-change-me-use-long-random-string
PORT=4087

# Skip prisma generate on every dev restart (run npm run generate -w server after schema changes):
SKIP_PRISMA_GENERATE=1

# Demo register loads when DB is empty (June–October sample society). Set to skip:
# SKIP_DEMO_SEED=1

# Vite dev server proxies /api to PORT; leave empty unless testing split origins:
# CLIENT_ORIGIN=http://127.0.0.1:5187
