# Production — copy to server/.env.production for local prod smoke tests (gitignored).
# On Render, set these in the dashboard instead of committing secrets.

NODE_ENV=production
APP_ENV=production

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

JWT_SECRET=use-long-random-secret-not-this-placeholder

PORT=10000

# Required when UI and API are on different hosts; for single Render web service use your public URL:
CLIENT_ORIGIN=https://your-service.onrender.com

SKIP_DEMO_SEED=1
SKIP_PRISMA_GENERATE=1
